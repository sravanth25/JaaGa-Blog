{
  "buildCommand": "node vercel-build.mjs",
  "outputDirectory": "dist",
  "installCommand": "echo 'skip'",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ]
}
