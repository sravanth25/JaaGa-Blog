{
  "name": "workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "build": "node artifacts/api-server/build.mjs && npm run build --workspace=@workspace/jaaga",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npx tsc -b && npm run typecheck",
    "start": "node server.ts",
    "dev": "concurrently \"PORT=8085 npm run dev --workspace=@workspace/api-server\" \"npm run dev --workspace=@workspace/jaaga\""
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vercel/node": "^5.8.3",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "prettier": "^3.8.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "next": "^14.2.23"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1"
  }
}
