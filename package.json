{
  "name": "workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "build": "node artifacts/api-server/build.mjs && NODE_ENV=production npm run build --workspace=@workspace/jaaga",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npx tsc -b && npm run typecheck",
    "start": "node server.ts",
    "dev": "concurrently \"npm run dev --workspace=@workspace/api-server\" \"npm run dev --workspace=@workspace/jaaga\""
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "prettier": "^3.8.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "next": "^16.4.6"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "postcss-selector-parser": "^6.1.5",
    "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
    "@esbuild-kit/core-utils": "npm:tsx@^4.21.0",
    "vite": "^7.3.8"
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "@types/react": "18.3.12",
      "@types/react-dom": "18.3.1"
    }
  }
}
